<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <!-- ========== GUÍAS ========== -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidePanelTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.42" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideImageEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.46" />

    <!-- ========== BLOQUE A1: CABECERA ========== -->
    <ImageView
        android:id="@+id/imgHeader"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_header_cards"
        app:layout_constraintBottom_toBottomOf="@id/guideImageEnd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/viewHeaderOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_header_overlay"
        app:layout_constraintBottom_toBottomOf="@id/imgHeader"
        app:layout_constraintEnd_toEndOf="@id/imgHeader"
        app:layout_constraintStart_toStartOf="@id/imgHeader"
        app:layout_constraintTop_toTopOf="@id/imgHeader" />

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="48dp"
        android:contentDescription="@string/cd_logo"
        android:src="@drawable/ic_logo_pokeball"
        app:layout_constraintStart_toStartOf="@id/guideStart"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/plus_jakarta_sans_extrabold"
        android:letterSpacing="0.04"
        android:text="@string/brand"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toEndOf="@id/imgLogo"
        app:layout_constraintTop_toTopOf="@id/imgLogo" />

    <ImageButton
        android:id="@+id/btnNotifications"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="@string/cd_notifications"
        android:src="@drawable/ic_notifications"
        app:layout_constraintBottom_toBottomOf="@id/imgLogo"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintTop_toTopOf="@id/imgLogo"
        app:tint="@color/navy_dark" />

    <TextView
        android:id="@+id/tvEyebrow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/plus_jakarta_sans_extrabold"
        android:letterSpacing="0.12"
        android:text="@string/eyebrow"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/tvHeroTitle1"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintStart_toStartOf="@id/guideStart" />

    <TextView
        android:id="@+id/tvHeroTitle1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans_extrabold"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:text="@string/hero_title_1"
        android:textColor="@color/white"
        android:textSize="32sp"
        app:layout_constraintBottom_toTopOf="@id/tvHeroTitle2"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintStart_toStartOf="@id/guideStart" />

    <TextView
        android:id="@+id/tvHeroTitle2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/plus_jakarta_sans_extrabold"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:text="@string/hero_title_2"
        android:textColor="@color/yellow"
        android:textSize="32sp"
        app:layout_constraintBottom_toTopOf="@id/tvHeroDesc"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintStart_toStartOf="@id/guideStart" />

    <TextView
        android:id="@+id/tvHeroDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:alpha="0.9"
        android:fontFamily="@font/plus_jakarta_sans_regular"
        android:lineSpacingExtra="3sp"
        android:text="@string/hero_desc"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/btnExplore"
        app:layout_constraintEnd_toEndOf="@id/guideEnd"
        app:layout_constraintStart_toStartOf="@id/guideStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExplore"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginBottom="28dp"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingStart="22dp"
        android:paddingEnd="24dp"
        android:text="@string/btn_explore"
        android:textAllCaps="false"
        android:textColor="@color/navy_dark"
        android:textSize="15sp"
        app:backgroundTint="@color/yellow"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_auto_awesome"
        app:iconPadding="12dp"
        app:iconSize="20dp"
        app:iconTint="@color/navy_dark"
        app:layout_constraintBottom_toBottomOf="@id/guidePanelTop"
        app:layout_constraintStart_toStartOf="@id/guideStart" />


    <!-- ========== BLOQUE A2: PANEL Y EXPLORA LA TIENDA ========== -->


    <!-- ========== BLOQUE B1: DESTACADO DE HOY ========== -->


    <!-- ========== BLOQUE B2: BARRA INFERIOR ========== -->

</androidx.constraintlayout.widget.ConstraintLayout>